<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.omnios.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__OMNIOS_REPO__/ops/run-server.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__OMNIOS_REPO__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__OMNIOS_HOME__/Library/Logs/omnios/server.log</string>
  <key>StandardErrorPath</key><string>__OMNIOS_HOME__/Library/Logs/omnios/server.log</string>
</dict>
</plist>
