<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.omnios.tunnel</string>
  <!-- cloudflared makes only OUTBOUND connections to Cloudflare's edge: no
       inbound port, no listener, nothing to scan. -->
  <key>ProgramArguments</key>
  <array>
    <string>__CLOUDFLARED__</string>
    <string>tunnel</string>
    <string>run</string>
    <string>omnios</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__OMNIOS_HOME__/Library/Logs/omnios/tunnel.log</string>
  <key>StandardErrorPath</key><string>__OMNIOS_HOME__/Library/Logs/omnios/tunnel.log</string>
</dict>
</plist>
