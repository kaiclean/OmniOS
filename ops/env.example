# OmniOS remote-access environment — copy to ~/.omnios/env and chmod 600.
# Everything the launchd services need lives here and ONLY here: no secret
# ever enters a plist or the repository.

# The access key. Every page and API requires it once set. Generate with:
#   openssl rand -base64 32
OMNIOS_ACCESS_KEY=

# The public URL the heartbeat checks — your tunnel hostname.
#   Cloudflare:  https://os.your-domain.com
#   Tailscale:   https://your-mac.your-tailnet.ts.net
OMNIOS_PUBLIC_URL=

# Where OmniOS keeps its data. Leave empty for <repo>/.omnios-data.
OMNIOS_DATA_DIR=

# How the workspace is stored there: empty for plain JSON files, `sqlite` for
# one SQLite database. An existing JSON workspace is imported on first run.
OMNIOS_STORE=

# Daily backups (ops/backup.sh). Defaults: ~/.omnios/backups, newest 14 kept.
# A backup contains the vault key — treat the directory like the data itself.
OMNIOS_BACKUP_DIR=
OMNIOS_BACKUP_KEEP=

# Optional: heartbeat failure alerts via your existing OmniOS Telegram bot.
# Leave empty to log-only. Chat id is the same one linked in Connections.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: MCP timeouts in milliseconds. Connect defaults to 90000 — a stdio
# server's cold first launch through npx/uvx legitimately downloads packages.
# Raise connect further on a slow link; call covers one tool invocation.
OMNIOS_MCP_CONNECT_TIMEOUT_MS=
OMNIOS_MCP_CALL_TIMEOUT_MS=
